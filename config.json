{
    "sass": {
        "loadPaths": [
            "src/assets/css/"
        ],
        "sourceMap": true,
        "sourceMapIncludeSources": true,
        "style": "compressed"
    },
    "esbuild": {
        "tsconfig": "jsconfig.json",
        "bundle": true,
        "minify": true
    },
    "htmlmin": {
        "collapseWhitespace": true,
        "removeComments": true
    }
}